#!/usr/bin/env zsh
# Opencode in a tmux popup (run via: tmux run-shell -b "zsh …/opencode-popup").

source_shell_environment() {
  local zprofile="${HOME}/.zprofile"
  local zshrc="${HOME}/.zshrc"
  [[ -f "$zprofile" ]] && source "$zprofile"
  [[ -f "$zshrc" ]]   && source "$zshrc"
}

source_shell_environment

typeset workdir
workdir=$(tmux display-message -p '#{pane_current_path}' 2>/dev/null) || workdir=
[[ -n "$workdir" && -d "$workdir" ]] || workdir="${HOME:-~}"

session="opencode_${workdir:t}"
session="${session//[^A-Za-z0-9_-]/_}"

# Same nesting guard as claude-popup (C-o from inside / while session exists).
typeset current_session
current_session=$(tmux display-message -p '#{session_name}' 2>/dev/null) || current_session=
[[ "$current_session" == opencode_* ]] && exit 0

if tmux has-session -t "$session" 2>/dev/null; then
  tmux display-message "Opencode already open for ${workdir:t} — use the existing popup"
  exit 0
fi

claude_env=()
[[ -n "${ANTHROPIC_BASE_URL:-}" ]]   && claude_env+=(ANTHROPIC_BASE_URL="$ANTHROPIC_BASE_URL")
[[ -n "${ANTHROPIC_AUTH_TOKEN:-}" ]] && claude_env+=(ANTHROPIC_AUTH_TOKEN="$ANTHROPIC_AUTH_TOKEN")
[[ -n "${ANTHROPIC_API_KEY:-}" ]]    && claude_env+=(ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY")
[[ -n "${ANTHROPIC_MODEL:-}" ]]      && claude_env+=(ANTHROPIC_MODEL="$ANTHROPIC_MODEL")

typeset inner
if (( $#claude_env )); then
  inner="tmux new-session -s ${(q)session} env"
  for e in "${claude_env[@]}"; do
    inner+=" ${(q)e}"
  done
  inner+=" opencode 2>/dev/null || tmux attach-session -t ${(q)session}"
else
  inner="tmux new-session -s ${(q)session} opencode 2>/dev/null || tmux attach-session -t ${(q)session}"
fi

tmux display-popup -E -T "Opencode" -w 30% -h 100% -xR -d "$workdir" /bin/sh -c "$inner" \
  || tmux display-message 'opencode-popup: display-popup failed (see tmux logs)'
