# =============================================================================
# LOCAL CONFIGURATION (Machine-Specific)
# =============================================================================
#
# Copy this file to ~/.config/zsh/local.zsh and customize for your machine.
# This file is NOT tracked in git.
#
# Usage:
#   cp ~/.config/zsh/local.zsh.example ~/.config/zsh/local.zsh
#   nvim ~/.config/zsh/local.zsh
#

# Work-only helpers (e.g. `swe`, the GCloud/GKE switcher) go in ~/.config/zsh/work.zsh,
# also untracked, so company project IDs stay out of this public repo.

# Machine identifier (used by tms for tmux session configs)
# Values: 'work', 'home', 'default', or custom
export MACHINE_NAME="default"

# Git user (if different per machine)
# git config --global user.name "Your Name"
# git config --global user.email "your@email.com"

# Work-specific aliases
# alias vpn='sudo openconnect --user=youruser vpn.company.com'

# Machine-specific paths
# export PATH="$HOME/custom-tools:$PATH"

# API keys: exported variables are visible to every process the shell starts (npm install
# scripts, npx, MCP servers). Keep keys in Keychain and pass them only to the command that
# needs them:
#   security add-generic-password -a "$USER" -s GEMINI_API_KEY -w   # prompts for the value
#   gemini() { GEMINI_API_KEY=$(security find-generic-password -s GEMINI_API_KEY -w) command gemini "$@"; }

# Work proxy settings
# export HTTP_PROXY="http://proxy.company.com:8080"
# export HTTPS_PROXY="http://proxy.company.com:8080"
# export NO_PROXY="localhost,127.0.0.1,.company.com"

# Multi-monitor cursor jump overrides (jump-display)
# Run 'jump-display list' to view detected monitors and coordinates.
# If not set, jump-display automatically detects screen centers dynamically.
# export DISPLAY_1_COORDS="960,540"
# export DISPLAY_2_COORDS="2880,540"
# export DISPLAY_3_COORDS="4800,540"


