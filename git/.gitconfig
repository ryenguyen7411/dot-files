# clearly makes git better
# (machine-specific includes are at the bottom so they can override anything here)

[alias]
	rm-merged = !git branch --format '%(refname:short) %(upstream:track)' | awk '$2 == \"[gone]\" { print $1 }' | xargs -r git branch -D
	fetcht = "!f() { \\\n  git fetch origin --tags && \\\n  git fetch --all --no-tags; \\\n}; f"
	difft = !GIT_EXTERNAL_DIFF=difft git diff
	logt = !GIT_EXTERNAL_DIFF=difft git log -p

[column]
  ui = auto
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
[init]
  defaultBranch = main
[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true
[push]
  default = simple
  autoSetupRemote = true
  followTags = true
[fetch]
  prune = true
  pruneTags = false
  all = true
[remote "origin"]
	prunetags = true

# why the hell not?

[help]
  autocorrect = prompt
[commit]
  verbose = true
[rerere]
  enabled = true
  autoupdate = true
[merge]
  conflictStyle = zdiff3
[core]
  # global ignores live at the default path, ~/.config/git/ignore (stowed from git/)
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  side-by-side = true
  line-numbers = true
[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true

# a matter of taste (uncomment if you dare)

# No global core.fsmonitor: it starts a daemon per repo on the first `git status` and the
# daemons never exit (217 of them, 660 MB, on 2026-10-12). Enable it per big repo instead:
#   git config core.fsmonitor true
[core]
  untrackedCache = true
# Never merge or rebase implicitly; use `git pull --rebase` when you mean it
[pull]
  ff = only

# Machine-specific settings (user, keys, ...), then the work identity for company repos.
# Last so they win over everything above.
[include]
  path = ~/.gitconfig-local
[includeIf "gitdir:~/projects/be/"]
  path = ~/.gitconfig-work
