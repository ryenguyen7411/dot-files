# SSH Configuration Template
# Copy this file to config.local and customize with your server details
#
# Usage:
#   cp ~/.ssh/config.example ~/.ssh/config.local
#   # Edit config.local with your actual server details
#   make install-ssh
#
# The install will symlink config.local -> config

# SSH Multiplexing - share connections across sessions
# Benefits:
#   - Faster subsequent connections (no re-authentication)
#   - All tmux panes share one underlying TCP connection
#   - Connection persists after sessions close (ControlPersist)
Host *
    ControlMaster auto
    # %C = hash of user/host/port: short, so long host names never hit the socket path limit
    ControlPath ~/.ssh/sockets/%C
    ControlPersist 600
    # Detect dead links (laptop sleep, Wi-Fi change) within ~90 s instead of hanging
    ServerAliveInterval 30
    ServerAliveCountMax 3

# Example server configuration:
# Host myserver
#   HostName your.server.com
#   User your-username
#   IdentityFile ~/.ssh/id_ed25519

# Host rye-opc
#   HostName 1.2.3.4
#   User ryeng
#   IdentityFile ~/.ssh/id_ed25519_server

